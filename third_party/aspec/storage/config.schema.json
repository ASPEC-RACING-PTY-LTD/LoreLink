{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Storage module configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "driver": {
      "enum": ["local", "s3"],
      "default": "local"
    },
    "metadata": {
      "enum": ["memory", "sqlite", "postgres"],
      "default": "memory"
    },
    "root": {
      "type": "string",
      "description": "Local driver root directory."
    },
    "bucket": {
      "type": "string"
    },
    "endpoint": {
      "type": "string"
    },
    "region": {
      "type": "string",
      "default": "us-east-1"
    },
    "maxBytes": {
      "type": "integer",
      "minimum": 1,
      "default": 26214400
    },
    "signingSecret": {
      "type": "string",
      "minLength": 32
    },
    "tablePrefix": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,30}$",
      "default": "storage_"
    }
  }
}
