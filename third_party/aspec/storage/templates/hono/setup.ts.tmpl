import { createStorage } from '{{ imports.root }}';
import { createMemoryMetadataStore } from '{{ imports.memory }}';
import { createLocalDriver } from '{{ imports.local }}';
import { createStorageHonoHandler } from '{{ imports.hono }}';

export const storage = createStorage({
  driver: createLocalDriver({ root: process.env.STORAGE_ROOT ?? './data/files' }),
  metadata: createMemoryMetadataStore(),
  signingSecret: process.env.STORAGE_SIGNING_SECRET!,
});
export const storageRoutes = createStorageHonoHandler({
  storage,
  basePath: '/files',
  publicBaseUrl: process.env.STORAGE_PUBLIC_BASE_URL,
});
